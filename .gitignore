adapter_model/
lora_out/

# Experiment tracking & caches
wandb/
mlruns/
.cache/
.huggingface/
huggingface/
torch_hub/
*.lock

# Keep experiment results -- these are the point of the project (rnd-docs/06, /08)
!results/
!results/**

# ---------------------------------------------------------------- secrets
# HF tokens, YouTube Data API keys. Never commit these.
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
credentials.json
client_secret*.json
token.json

# A local config override, so the committed configs/pipeline.yaml stays generic
configs/*.local.yaml
configs/local/

